fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="55D6723F" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00F16E88" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="EE0000"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:pPr><w:r w:rsidRPr="00F16E88"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="EE0000"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t>BÁO CÁO THIẾT KẾ KIẾN TRÚC MICROSERVICES</w:t></w:r></w:p><w:p w14:paraId="1EE9C86F" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00F16E88" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="EE0000"/></w:rPr></w:pPr><w:r w:rsidRPr="00F16E88"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="EE0000"/></w:rPr><w:t>HỆ THỐNG ĐẶT VÉ XE KHÁCH TRỰC TUYẾN</w:t></w:r></w:p><w:p w14:paraId="09BB133C" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr><w:t>1. TỔNG QUAN KIẾN TRÚC HỆ THỐNG</w:t></w:r></w:p><w:p w14:paraId="68DD8E28" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t xml:space="preserve">Hệ thống được thiết kế theo kiến trúc Microservices kết hợp mẫu thiết kế API Gateway (API Gateway Pattern). Toàn bộ hệ thống được phân rã thành các dịch vụ độc lập (services), mỗi dịch vụ đảm nhiệm một ranh giới nghiệp vụ (Bounded Context) cụ thể và quản lý một cơ sở dữ liệu riêng biệt theo nguyên tắc </w:t></w:r><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:i/><w:iCs/></w:rPr><w:t>Database per Service</w:t></w:r><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="16A37890" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Kiến trúc này giúp hệ thống dễ dàng mở rộng, cô lập lỗi (nếu một dịch vụ chết, các dịch vụ khác vẫn hoạt động) và tối ưu hóa việc phát triển độc lập. Hệ thống Backend được xây dựng trên nền tảng ExpressJS.</w:t></w:r></w:p><w:p w14:paraId="1854F299" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr><w:t>2. PHÂN RÃ DỊCH VỤ VÀ CƠ SỞ DỮ LIỆU (SERVICE DECOMPOSITION)</w:t></w:r></w:p><w:p w14:paraId="0DEB9999" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Hệ thống bao gồm 1 API Gateway và 5 Microservices cốt lõi:</w:t></w:r></w:p><w:p w14:paraId="22703709" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr><w:t>2.1. API Gateway (Cổng giao tiếp API)</w:t></w:r></w:p><w:p w14:paraId="45FC0D71" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Nhiệm vụ: Đóng vai trò là điểm vào duy nhất (Single Entry Point) cho mọi request từ Frontend (Next.js).</w:t></w:r></w:p><w:p w14:paraId="719C723A" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Chức năng cốt lõi:</w:t></w:r></w:p><w:p w14:paraId="19D71488" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="9"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Routing: Phân luồng request đến đúng Microservice phía sau (Reverse Proxy sử dụng http-proxy-middleware).</w:t></w:r></w:p><w:p w14:paraId="6B3B69D0" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="9"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Authentication (Soát vé): Kiểm tra và xác thực tính hợp lệ (Verify) của JWT Token trước khi cho phép request đi sâu vào hệ thống. API Gateway hoàn toàn không có quyền tạo ra token mới.</w:t></w:r></w:p><w:p w14:paraId="61574A8B" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Database: Không có.</w:t></w:r></w:p><w:p w14:paraId="6CD3AB9B" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/></w:rPr><w:t>2.2. User Service (Dịch vụ Người dùng / Auth Server)</w:t></w:r></w:p><w:p w14:paraId="0F6B55D8" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Nhiệm vụ: Quản lý thông tin tài khoản và xác thực người dùng. Chịu trách nhiệm trực tiếp trong việc cấp phát (Generate) Access Token và quản lý vòng đời của Refresh Token.</w:t></w:r></w:p><w:p w14:paraId="23C8EEC0" w14:textId="77777777" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t>Database (Bảng quản lý):</w:t></w:r></w:p><w:p w14:paraId="6E7C06D3" w14:textId="57FF0F8D" w:rsidR="00B857BD" w:rsidRPr="00B857BD" w:rsidRDefault="00B857BD" w:rsidP="00B857BD"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00B857BD"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/></w:rPr><w:t xm